# Entornos y dependencias locales
.venv/
venv/
node_modules/
.build-staging/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Compilación y entregas: se regeneran con build.ps1
/target/
/dist/
build/
/ui/dist/

# Escritorio (Electron): dependencias, paquetes (portable e instalador) y el icono que genera npm run icon
/desktop/node_modules/
/desktop/dist/
/desktop/build/

# Toolchains que descargan los bootstrap (MinGW, Go...)
/tools/bootstrap/
**/tools/bootstrap/

# Todo lo descargado o instalado por el usuario vive en vendor/ y no se versiona
# (references/, toolpacks/, installers/, jpexs-source/, third_party/)
/vendor/
.dev-references/

# Informes y resultados de benchmarks (se regeneran)
reports/

# Binarios compilados de los motores propios
engines/*/dist/

# Configuración local de editores y agentes
.claude/
.vscode/
.idea/
*.log
*.tmp
