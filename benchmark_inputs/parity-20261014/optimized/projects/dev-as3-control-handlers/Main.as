package { import flash.display.Sprite; public class Main extends Sprite { public function Main(){ super(); trace("PARITY_HANDLER_"+calculate(3)); } private function calculate(n:int):int { var sum:int=0; try { for(var i:int=0;i<n;i++){switch(i){case 0:sum+=2;break;case 1:sum+=3;break;default:sum+=5;}} if(n<0) throw new Error("negative"); } catch(error:Error) {sum=-1;} finally {sum+=1;} return sum; } } }