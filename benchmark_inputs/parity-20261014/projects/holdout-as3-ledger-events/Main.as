package { import flash.display.Sprite; import flash.events.Event; public class Main extends Sprite { public function Main(){ super(); ledger={cash:12,credit:7,refund:3};addEventListener("ready",onReady);dispatchEvent(new Event("ready"));graphics.beginFill(0x33aa11);graphics.drawRect(20,20,40,40);graphics.endFill(); } private var ledger:Object; private function onReady(event:Event):void{var total:int=int(ledger.cash)+int(ledger.credit)-int(ledger.refund);trace("PARITY_HOLDOUT_LEDGER_"+total);} } }