{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"Flash Universal Studio",
  "version":"0.3.0",
  "identifier":"com.rustswf.studio",
  "build":{"frontendDist":"../web/dist","devUrl":"http://localhost:1420"},
  "app":{
    "windows":[{"title":"Flash Universal Studio","width":1380,"height":880,"minWidth":960,"minHeight":640,"backgroundColor":"#0b1018"}],
    "security":{
      "csp":"default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'none'",
      "assetProtocol":{"enable":true,"scope":["$TEMP/rustswf-studio/**"]}
    }
  },
  "bundle":{"active":true,"targets":["nsis"],"licenseFile":"../LICENSE","icon":["icons/icon.ico"],"resources":{"binaries/rustswf.exe":"binaries/rustswf.exe","binaries/FlashSuiteWorker.exe":"binaries/FlashSuiteWorker.exe","binaries/WebView2Loader.dll":"WebView2Loader.dll","../LICENSE":"LICENSE","../THIRD_PARTY_NOTICES.md":"THIRD_PARTY_NOTICES.md","../dist/RustSWFStudio/licenses/":"licenses/"},"windows":{"webviewInstallMode":{"type":"embedBootstrapper"},"nsis":{"languages":["Spanish","English"],"displayLanguageSelector":true,"installMode":"currentUser"}}}
}
